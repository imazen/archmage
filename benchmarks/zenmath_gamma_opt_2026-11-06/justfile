set shell := ["bash", "-euo", "pipefail", "-c"]

fmt:
    cargo +1.99.1 fmt

check:
    cargo +1.99.1 test --release
    cargo +1.99.1 clippy --all-targets --release -- -D warnings

build:
    cargo +1.99.1 build --release

# Run only on admitted remote host with explicit isolated output paths.
generate rust proof summary:
    PYTHONDONTWRITEBYTECODE=1 python3 generate.py --rust {{rust}} --proof {{proof}} --summary {{summary}}
